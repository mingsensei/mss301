{
  "info": {
    "name": "MSS301 – Slot7 (OpenFeign + Gateway + Keycloak)",
    "_postman_id": "mss301-slot7-2026",
    "description": "Test Slot7: OpenFeign (Order→Inventory), API Gateway (:9090), Keycloak OAuth2 JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:9090" },
    { "key": "product_url", "value": "http://localhost:8080" },
    { "key": "order_url",   "value": "http://localhost:8081" },
    { "key": "inventory_url", "value": "http://localhost:8082" },
    { "key": "keycloak_url", "value": "http://localhost:8181" },
    { "key": "realm", "value": "spring-microservices-realm" },
    { "key": "client_id", "value": "spring-microservices-client" },
    { "key": "client_secret", "value": "mss301-dev-secret-change-me" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "📦 1. Direct – Không qua Gateway",
      "item": [
        {
          "name": "GET Products (direct :8080)",
          "request": {
            "method": "GET",
            "url": "{{product_url}}/api/products"
          }
        },
        {
          "name": "POST Product (direct :8080)",
          "request": {
            "method": "POST",
            "url": "{{product_url}}/api/products",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"description\": \"Apple iPhone 15\",\n  \"price\": 999\n}"
            }
          }
        },
        {
          "name": "GET Inventory – Còn hàng (direct :8082)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{inventory_url}}/api/inventory?skuCode=iphone_15&quantity=1",
              "host": ["{{inventory_url}}"],
              "path": ["api", "inventory"],
              "query": [
                { "key": "skuCode", "value": "iphone_15" },
                { "key": "quantity", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "GET Inventory – Hết hàng (direct :8082)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{inventory_url}}/api/inventory?skuCode=iphone_15&quantity=101",
              "host": ["{{inventory_url}}"],
              "path": ["api", "inventory"],
              "query": [
                { "key": "skuCode", "value": "iphone_15" },
                { "key": "quantity", "value": "101" }
              ]
            }
          }
        },
        {
          "name": "POST Order – Còn hàng → 201 (direct :8081)",
          "request": {
            "method": "POST",
            "url": "{{order_url}}/api/order",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 999,\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "POST Order – Hết hàng → 500 (direct :8081)",
          "request": {
            "method": "POST",
            "url": "{{order_url}}/api/order",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 999,\n  \"quantity\": 101\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🔑 2. Keycloak – Lấy Token",
      "item": [
        {
          "name": "GET Token (Client Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "console.log('Token saved:', json.access_token.substring(0,50) + '...');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🌐 3. API Gateway (port 9090) – Có Token",
      "item": [
        {
          "name": "GET Products qua Gateway → 200",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/products",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "POST Product qua Gateway → 201",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/api/products",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samsung S24\",\n  \"description\": \"Samsung Galaxy S24\",\n  \"price\": 899\n}"
            }
          }
        },
        {
          "name": "POST Order qua Gateway – Còn hàng → 201",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/api/order",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 999,\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "POST Order qua Gateway – Hết hàng → 500",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/api/order",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 999,\n  \"quantity\": 101\n}"
            }
          }
        },
        {
          "name": "GET Inventory qua Gateway → 200",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway_url}}/api/inventory?skuCode=iphone_15&quantity=1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "inventory"],
              "query": [
                { "key": "skuCode", "value": "iphone_15" },
                { "key": "quantity", "value": "1" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "🔒 4. Bảo mật – Test 401",
      "item": [
        {
          "name": "GET Products – Không có token → 401",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/products"
          }
        },
        {
          "name": "POST Order – Không có token → 401",
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/api/order",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 999,\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "GET Products – Token sai → 401",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/products",
            "header": [{ "key": "Authorization", "value": "Bearer eyJhbGciOiJSUzI1NiJ9.INVALID.SIGNATURE" }]
          }
        },
        {
          "name": "GET Actuator Health – Không cần token → 200",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/actuator/health"
          }
        }
      ]
    }
  ]
}
